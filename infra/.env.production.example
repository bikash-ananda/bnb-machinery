# Copy to infra/.env.production on the server, complete every required value, then chmod 600.
# Generate passwords/secrets on the server: openssl rand -hex 32
# Replace the TEST-NET admin IP with your own stable public IP/CIDR before launch.
# For real TLS, DOMAIN and APP_ORIGIN must resolve to this VPS before starting Caddy.

DOMAIN=machinery-tools.com
APP_ORIGIN=https://machinery-tools.com
APP_HOST_PORT=3083
ADMIN_ALLOWED_IPS=203.0.113.1/32

# This app currently uses local Postgres for commerce and Supabase for catalog/admin auth.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://bnb:change-me@postgres:5432/bnb?sslmode=disable
REDIS_URL=redis://:change-me@redis:6379
REDIS_PASSWORD=change-me
MEDIA_DIR=/data/media
BOT_DATA_DIR=/data/bot

# Supabase remains required for admin authentication, OTP and legacy inventory services.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OTP_HASH_SECRET=
RESEND_API_KEY=
OTP_FROM_EMAIL=Machinery Tools Nepal <no-reply@example.com>
AUTOMATION_FROM_EMAIL=Machinery Tools Nepal <no-reply@example.com>
AUTOMATION_ALERT_EMAIL=bikashengineering100@gmail.com
# Generate with: openssl rand -hex 32
AUTOMATION_CRON_SECRET=replace-with-a-random-64-character-hex-secret
OWNER_EMAIL=bikashengineering100@gmail.com
ORDER_NOTIFY_EMAIL=bikashengineering100@gmail.com

OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

