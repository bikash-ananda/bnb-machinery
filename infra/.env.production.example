# Copy to infra/.env.production on the server, complete every required value, then chmod 600.
# Generate passwords/secrets on the server: openssl rand -hex 32
# Replace the TEST-NET admin IP with your own stable public IP/CIDR before launch.
# For real TLS, DOMAIN and APP_ORIGIN must resolve to this VPS before starting Caddy.

DOMAIN=bnbmachinery.com
APP_ORIGIN=https://bnbmachinery.com
APP_HOST_PORT=3083
ADMIN_ALLOWED_IPS=203.0.113.1/32

# Private business database remains on the VPS. Do NOT replace DATABASE_URL with Neon.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://bnb:change-me@postgres:5432/bnb?sslmode=disable
REDIS_URL=redis://:change-me@redis:6379
REDIS_PASSWORD=change-me
MEDIA_DIR=/data/media
BOT_DATA_DIR=/data/bot

# External public data services (NOT ACTIVE until implementation and owner-approved rollout).
# Neon contains only the explicitly allowlisted public catalog projection.
PUBLIC_CATALOG_DATABASE_URL=
# Cloudflare R2 public bucket: only approved/published public files may be copied here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_PUBLIC_BASE_URL=
PUBLIC_CATALOG_READ_ENABLED=false
PUBLIC_CATALOG_SYNC_ENABLED=false
PUBLIC_MEDIA_R2_ENABLED=false

OTP_HASH_SECRET=
RESEND_API_KEY=
OTP_FROM_EMAIL=B&B Machinery <no-reply@example.com>
AUTOMATION_FROM_EMAIL=B&B Machinery <no-reply@example.com>
AUTOMATION_ALERT_EMAIL=bikashengineering100@gmail.com
# Generate with: openssl rand -hex 32
AUTOMATION_CRON_SECRET=replace-with-a-random-64-character-hex-secret
OWNER_EMAIL=bikashengineering100@gmail.com
ORDER_NOTIFY_EMAIL=bikashengineering100@gmail.com

OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
