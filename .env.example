# Public application origin used by same-origin mutation checks.
APP_ORIGIN=http://localhost:3000

# Supabase project. Use the service role key only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend sender configuration for staff OTP email.
RESEND_API_KEY=
OTP_FROM_EMAIL=

# Automated customer messages use Resend; defaults to OTP_FROM_EMAIL when blank.
AUTOMATION_FROM_EMAIL=
AUTOMATION_ALERT_EMAIL=
AUTOMATION_CRON_SECRET=

# At least 32 characters. Generate a unique random value per environment.
OTP_HASH_SECRET=

# Admin AI assistant (never use NEXT_PUBLIC_ names for these values).
# Existing OPENAI_API_KEY / OPENAI_MODEL may be used when AI_PROVIDER=openai and AI_MODEL is blank.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=900
AI_TEMPERATURE=0.2
AI_RATE_LIMIT_PER_MINUTE=12
# Optional provider fallback; set a complete provider, model, base URL and key.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_API_BASE_URL=
# Optional per-model prices in USD per million tokens. Cost remains unknown until set.
AI_INPUT_USD_PER_MILLION_TOKENS=
AI_OUTPUT_USD_PER_MILLION_TOKENS=
AI_FALLBACK_INPUT_USD_PER_MILLION_TOKENS=
AI_FALLBACK_OUTPUT_USD_PER_MILLION_TOKENS=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional image identification. Both values are required to enable it.
OPENAI_API_KEY=
OPENAI_MODEL=
SUPPORT_RETENTION_DAYS=180

# Optional public machinery reference search. Create a Programmable Search Engine and API key.
# These are used only by the server for machinery troubleshooting/spec questions.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Optional single owner login. Leave empty until the owner address is confirmed.
OWNER_EMAIL=
